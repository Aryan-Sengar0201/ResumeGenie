# ResumeGenie Configuration Example
# Copy this file to .env and configure your variables

# Google Gemini API Key (Optional)
# If left empty, ResumeGenie automatically utilizes its high-accuracy deterministic heuristic engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
